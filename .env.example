# For npm run dev outside Docker. Docker Compose sets the internal service URL.
MAILPIT_URL=http://localhost:8025

# Optional on Vercel: defaults to the project's production domain.
# For other hosts, set your public origin before the production build.
SITE_URL=http://localhost:3000

# Production only. Set these in Vercel's environment settings.
# Never put real credentials in this example file or NEXT_PUBLIC_ variables.
RESEND_API_KEY=
# Test sender: CONTACT_TO_EMAIL must be your Resend account email.
# For other recipients, use a sender on a domain you verified with Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=
